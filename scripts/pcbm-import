#!/bin/bash
# Fixed removable-media broker; no device paths or generic root commands.
set -uo pipefail
source /usr/share/project-cbm-menu/pcbm-ui.sh
pcbm_ui_terminal_size
bridge=/usr/libexec/project-cbm-menu/pcbm_config_bridge.py
reply=$(printf '%s\n' '{"schema_version":1,"operation":"list"}' | /usr/bin/pcbm-import-operation)
if ! rows=$(printf '%s' "$reply" | /usr/bin/python3 "$bridge" import-list); then
  pcbm_ui_message "Import unavailable" "Complete setup, then attach a supported USB drive. The broker accepts unmounted USB partitions; it never imports from the running system disk." || true;exit 2
fi
options=()
while IFS=$'\t' read -r token label;do [[ -z $token ]] || options+=("$token" "$label");done <<< "$rows"
if (( ${#options[@]} == 0 ));then
  pcbm_ui_message "No import source" "Attach an unmounted USB partition formatted as FAT, exFAT or ext4. Already mounted disks and the running system disk are excluded." || true;exit 0
fi
pcbm_ui_menu "Import from USB" "Choose the source partition. It will be mounted read-only." "${options[@]}" || exit 0
token=$PCBM_UI_CHOICE
families=$(/usr/bin/pcbm-profiles content-families) || exit 2
options=()
while IFS=$'\t' read -r family label; do
  [[ -z $family ]] || options+=("$family" "$label")
done <<< "$families"
pcbm_ui_menu "Content machine" "Choose the machine this content is for. Shared keeps unclassified material together; it does not make files compatible with every machine." "${options[@]}" || exit 0
family=$PCBM_UI_CHOICE
pcbm_ui_menu "Import destination" "Supported regular files go into the selected category and machine's Imported folder. SID files go into music/c64. Existing files are preserved. This candidate limits one import to 2 GiB and keeps 256 MiB free." programs "Programs / applications" games "Games / disk images" demos "Demos" music "Music / SID" || exit 0
category=$PCBM_UI_CHOICE
case $category in programs|games|demos|music) ;; *) exit 2 ;; esac
pcbm_ui_working "Importing supported content. Leave the USB drive connected until the result appears." || true
reply=$(printf '%s\n' "$token" "$category" "$family" | /usr/bin/python3 "$bridge" import-request | /usr/bin/pcbm-import-operation)
if message=$(printf '%s' "$reply" | /usr/bin/python3 "$bridge" import-result);then
  pcbm_ui_message "Import complete" "$message
Destination: /home/pcbm/content/$category/$family/Imported
SID files: /home/pcbm/content/music/c64/Imported" || true
else
  message=$(printf '%s' "$reply" | /usr/bin/python3 "$bridge" import-error 2>/dev/null) || message="Import did not return a usable result. Existing files were preserved. Drive release was not confirmed; leave it connected until a safe shutdown."
  pcbm_ui_message "Import incomplete" "$message" || true;exit 2
fi
