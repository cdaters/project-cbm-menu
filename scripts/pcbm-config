#!/bin/bash
# Project CBM configuration: unprivileged UI, explicit requests, no detection logic.
# Copyright Project CBM contributors; MIT.
set +x
set -uo pipefail
source /usr/share/project-cbm-menu/pcbm-ui.sh
source /usr/share/project-cbm-menu/pcbm-setup-ui.sh
pcbm_ui_terminal_size
PCBM_CONFIG_NOTICE=
PCBM_CONFIG_STATUS=
bridge=/usr/libexec/project-cbm-menu/pcbm_config_bridge.py
notify() { pcbm_ui_message "$1" "$2" || true; }
choose() {
  local title=$1; shift
  if pcbm_ui_menu "$title" "${PCBM_CONFIG_STATUS}${PCBM_CONFIG_STATUS:+
}${PCBM_CONFIG_NOTICE:-Choose a setting. Escape returns.}" "$@" BACK "Back"; then
    PCBM_CONFIG_NOTICE=
    [[ $PCBM_UI_CHOICE != BACK ]]
  else
    case $? in 1|2) return 1 ;; *) printf '%s\n' 'Configuration requires a usable dialog terminal (at least 40x12).' >&2; exit 3 ;; esac
  fi
}
ready() {
  if /usr/bin/pcbm-config-operation --ready "$1"; then return 0; fi
  notify "Setup required" "Complete local first-boot setup before changing this setting. Project CBM remains usable offline."
  return 1
}
apply_setting() {
  local op=$1 reply text rc=0 label="Applying configuration..."; shift
  case $op in
    wifi-country) label="Configuring Wi-Fi country and radio..." ;;
    wifi-rescan) label="Waiting for Wi-Fi readiness and a fresh scan (up to 25 seconds)..." ;;
    wifi-enroll) label="Connecting to Wi-Fi (up to 30 seconds)..." ;;
    keyboard) label="Configuring keyboard for next boot..." ;;
    locale) label="Applying language settings..." ;;
    timezone) label="Setting timezone..." ;;
  esac
  pcbm_ui_working "$label" || return 1
  # printf is a Bash builtin. Secret values never appear in child argv or files here.
  reply=$(printf '%s\n' "$@" | /usr/bin/python3 "$bridge" request "$op" | /usr/bin/pcbm-config-operation 2>/dev/null)
  if text=$(printf '%s' "$reply" | /usr/bin/python3 "$bridge" result 2>/dev/null); then
    PCBM_CONFIG_NOTICE=
    [[ $op == service || $op == sharing-password ]] || PCBM_CONFIG_NOTICE=$text
  else
    rc=1
    notify "Setting not active" "${text:-Configuration is pending runtime activation. Please review the current status and retry.}"
  fi
  unset reply text
  return "$rc"
}
request() { apply_setting "$@"; }
edit_value() {
  local op=$1 help=$2
  ready "$op" || return 0
  if pcbm_ui_input "Project CBM" "$help"; then apply_setting "$op" "$PCBM_UI_CHOICE"; fi
}
show_about() {
  local dir
  umask 077
  dir=$(mktemp -d "${TMPDIR:-/tmp}/pcbm-about.XXXXXXXX") || return 3
  if /usr/bin/pcbm-info --json | /usr/bin/python3 "$bridge" about "$COLUMNS" >"$dir/view"; then
    pcbm_ui_textbox "About Project CBM" "$dir/view" || true
  else notify "About Project CBM" "Project CBM is a Commodore appliance for Raspberry Pi. Installed build information is unavailable. See https://github.com/cdaters/project-cbm"; fi
  rm -f "$dir/view"; rmdir "$dir"
}
status_refresh() {
  PCBM_APPLIANCE=$(/usr/bin/pcbm-info --json --appliance 2>/dev/null) || PCBM_APPLIANCE=
}
status_text() {
  printf '%s' "$PCBM_APPLIANCE" | /usr/bin/python3 /usr/libexec/project-cbm-menu/pcbm_status_view.py "$@" 2>/dev/null
}
connection_help() {
  local dir
  umask 077
  dir=$(mktemp -d "${TMPDIR:-/tmp}/pcbm-connection.XXXXXXXX") || return 3
  if status_text connection "$1" > "$dir/view";then pcbm_ui_textbox "How to connect" "$dir/view" || true
  else notify "Connection information" "Current information is unavailable. Check System Information.";fi
  rm -f "$dir/view";rmdir "$dir"
}
sharing_password() {
  local secret
  ready sharing-password || return 1
  if pcbm_ui_secret "File Sharing password" "File Sharing uses a separate password (12-128 printable characters). Sign in with the username shown on its service screen.";then
    secret=$PCBM_UI_CHOICE;PCBM_UI_CHOICE=
    if pcbm_ui_secret "Confirm File Sharing password" "Enter the same password again.";then
      if [[ $secret == "$PCBM_UI_CHOICE" ]];then
        PCBM_UI_CHOICE=
        apply_setting sharing-password "$secret";local rc=$?
        unset secret;return "$rc"
      fi
      notify "Not saved" "Passwords did not match."
    fi
  fi
  unset secret;PCBM_UI_CHOICE=;return 1
}
region() {
  while choose "Language, Keyboard and Region" LOCALE "System language/locale" KEYBOARD "Console keyboard layout" TIMEZONE "Timezone"; do
    case $PCBM_UI_CHOICE in
      LOCALE) if ready locale && pcbm_setup_choice region;then apply_setting locale "$PCBM_UI_CHOICE";fi ;;
      KEYBOARD) if ready keyboard && pcbm_setup_choice keyboard;then apply_setting keyboard "$PCBM_UI_CHOICE";fi ;;
      TIMEZONE) if ready timezone && pcbm_setup_choice timezone;then apply_setting timezone "$PCBM_UI_CHOICE";fi ;;
    esac
  done
}
network() {
  while true; do
    status_refresh
    PCBM_CONFIG_STATUS=$(status_text view network) || PCBM_CONFIG_STATUS="Network information unavailable"
    choose "Network" STATUS "Network information (IP/MAC and status)" HOSTNAME "Computer Name" COUNTRY "Wi-Fi country and radio" SCAN "Nearby Wi-Fi networks" WIFI "Join Wi-Fi by name (WPA personal)" DISCONNECT "Disconnect Project CBM Wi-Fi" FORGET "Forget Project CBM Wi-Fi" ONLINE "Enable normal networking" OFFLINE "Stay offline (disable connections)" || break
    case $PCBM_UI_CHOICE in
      STATUS) /usr/bin/pcbm-system-info ;;
      HOSTNAME) edit_value hostname "Computer Name: lowercase letters, digits and hyphens; for example projectcbm. Other computers use this name when Network Discovery is on." ;;
      COUNTRY)
        if pcbm_ui_confirm "Wi-Fi country" "Set the country where this Pi is used. This enables the Wi-Fi radio. Continue?" && ready wifi-country && pcbm_setup_choice country;then apply_setting wifi-country "$PCBM_UI_CHOICE";fi ;;
      SCAN)
        ready wifi-enroll || continue
        if pcbm_setup_wifi '';then PCBM_CONFIG_NOTICE="Connected to Wi-Fi."
        else rc=$?;[[ $rc != 2 ]] || apply_setting network false;fi ;;
      WIFI)
        ready wifi-enroll || continue
        notify "Wi-Fi" "Set your Wi-Fi country first. This joins one WPA personal network; enterprise, open networks and unusual settings use authenticated owner administration. Existing owner-managed connections are retained."
        if pcbm_ui_input "Wi-Fi network" "Network name (SSID), exactly as configured, up to 32 UTF-8 bytes."; then
          ssid=$PCBM_UI_CHOICE
          if pcbm_ui_secret "Wi-Fi password" "WPA personal password (8-63 ASCII characters). It will not be logged."; then
            secret=$PCBM_UI_CHOICE; PCBM_UI_CHOICE=
            if pcbm_ui_confirm "Join Wi-Fi?" "Save this connection and attempt to join it? This enables network access."; then apply_setting wifi-enroll "$ssid" "$secret"; fi
            unset secret
          fi
          unset ssid; PCBM_UI_CHOICE=
        fi ;;
      DISCONNECT) apply_setting wifi-disconnect ;;
      FORGET) if pcbm_ui_confirm "Forget Wi-Fi?" "Remove the one Project CBM-managed Wi-Fi connection? Owner-managed profiles remain unchanged."; then apply_setting wifi-forget;fi ;;
      ONLINE) if pcbm_ui_confirm "Enable networking?" "Allow NetworkManager to activate configured Ethernet/Wi-Fi connections? Optional services remain separately controlled."; then apply_setting network true; fi ;;
      OFFLINE) if pcbm_ui_confirm "Stay offline?" "Disconnect networking, including Ethernet and remote sessions? Project CBM remains usable offline."; then apply_setting network false; fi ;;
    esac
  done
  PCBM_CONFIG_STATUS=
}
service_screen() {
  local service=$1 label=$2 tag action enabled port
  while true;do
    status_refresh
    PCBM_CONFIG_STATUS=$(status_text view "$service") || PCBM_CONFIG_STATUS="Status: Unavailable"
    options=()
    while IFS=$'\t' read -r tag action;do
      [[ -n $tag ]] && options+=("$tag" "$action")
    done < <(status_text actions "$service")
    [[ $service != sharing ]] || options+=(PASSWORD "Set / change File Sharing password")
    [[ $service != modem ]] || options+=(SETTINGS "Modem port and speed")
    options+=(CONNECTION "How to connect" REFRESH "Refresh status")
    choose "$label" "${options[@]}" || break
    case $PCBM_UI_CHOICE in
      ENABLE)
        if [[ $service == sharing ]];then
          if [[ $(status_text field sharing_password_set) != yes ]];then sharing_password || continue;fi
          pcbm_ui_confirm "Turn On File Sharing" "Share your Project CBM content with password-protected access on your home network? Network Discovery will also turn on." || continue
        else
          pcbm_ui_confirm "Turn On $label" "Allow $label on your home network? You can turn it off on this screen." || continue
        fi
        apply_setting service "$service" true || true ;;
      DISABLE) apply_setting service "$service" false || true ;;
      PASSWORD) sharing_password || true ;;
      CONNECTION) connection_help "$service" ;;
      REFRESH) ;;
      SETTINGS)
        if pcbm_ui_input "Modem" "Local emulator modem port (1024-65535), normally 25232.";then
          port=$PCBM_UI_CHOICE
          if pcbm_ui_input "Modem" "Baud: 300, 1200, 2400, 9600, 19200 or 38400.";then apply_setting modem "$port" "$PCBM_UI_CHOICE";fi
        fi ;;
    esac
  done
  PCBM_CONFIG_STATUS=
}
services() {
  while true;do
    status_refresh
    PCBM_CONFIG_STATUS=$(status_text view services) || PCBM_CONFIG_STATUS="Service information unavailable"
    choose "Services" SHARING "File Sharing" SSH "Remote Access (SSH)" DISCOVERY "Network Discovery" MODEM "BBS / Modem" || break
    case $PCBM_UI_CHOICE in
      SHARING) service_screen sharing "File Sharing" ;;
      SSH) service_screen ssh "Remote Access (SSH)" ;;
      DISCOVERY) service_screen discovery "Network Discovery" ;;
      MODEM) service_screen modem "BBS / Modem" ;;
    esac
  done
  PCBM_CONFIG_STATUS=
}
machine() {
  while choose "Machine and Startup" DEFAULT "Choose default Commodore machine" BOOT "Boot preference"; do
    case $PCBM_UI_CHOICE in
      DEFAULT) /usr/bin/pcbm-machines --default ;;
      BOOT)
        if choose "Boot preference" MENU "Menu (recommended)" EMULATOR "Default emulator"; then
          value=menu;[[ $PCBM_UI_CHOICE != EMULATOR ]] || value=emulator
          if /usr/bin/pcbm-preferences set boot_preference "$value" >/dev/null 2>&1; then
            PCBM_CONFIG_NOTICE="Preference saved for the next login/boot. After the emulator exits or fails, Project CBM returns to Menu."
          else notify "Not saved" "Check user preferences/recovery instructions. No administrator password is needed."; fi
        fi ;;
    esac
  done
}
picture() {
  while choose "Picture, Sound and Controllers" AUDIO "Audio output and test" MIXER "Advanced Mixer (ALSA)" VIDEO "Display / VICE picture settings" INPUT "VICE keyboard and controller settings"; do
    case $PCBM_UI_CHOICE in
      AUDIO) /usr/bin/pcbm-audio ;;
      MIXER)
        if [[ -x /usr/bin/alsamixer ]] && (( EUID != 0 )); then
          if /usr/bin/alsamixer; then
            PCBM_CONFIG_NOTICE="Mixer closed. Changes affect available ALSA controls; persistence follows the system's ALSA policy."
          else
            PCBM_CONFIG_NOTICE="Mixer unavailable for this device/session. Some digital outputs have no hardware mixer controls. Audio output settings remain available."
          fi
          stty sane 2>/dev/null || true
        else
          PCBM_CONFIG_NOTICE="Advanced Mixer requires alsa-utils and the normal Project CBM user session."
        fi ;;

      VIDEO) notify "Display" "Project CBM initializes VICE with true-aspect fullscreen presentation. Unused side areas are intentional. Change emulator picture preferences in VICE via F10; saved preferences are retained. Advanced Raspberry Pi display options are under Advanced → raspi-config." ;;
      INPUT) notify "Keyboard and controllers" "Host keyboard layout is under Language, Keyboard and Region. Configure emulator keys and joystick ports in VICE via F10. No controller is required to operate Project CBM." ;;
    esac
  done
}
storage() {
  while choose "Content and Storage" SPACE "Capacity and free space" LOCATIONS "Content locations / USB import" BACKUP "Backup and restore guidance"; do
    case $PCBM_UI_CHOICE in
      SPACE) /usr/bin/pcbm-system-info ;;
      LOCATIONS) notify "Content" "Use CONTENT, FILES and IMPORT on Main Menu. Content remains under /home/pi/pcbm (games, demos, programs, music and ROM resources). IMPORT copies chosen files into the selected content folder and safely disconnects the source. Find them in CONTENT or FILES." ;;
      BACKUP) notify "Backup and restore" "Keep an external copy of your content, user preferences and VICE configuration. For major/base upgrades: back up, flash a fresh image, then validate a selective restore. Never restore machine identity, host keys or old system configuration wholesale. Automated restore is pending; Advanced owner administration can copy your files." ;;
    esac
  done
}
advanced() {
  while choose "Advanced" TERMINAL "Owner terminal (authenticated; exit returns)" RASPI "Authenticated raspi-config" DIAGNOSTICS "Engineering diagnostics" GUIDE "Administration and recovery guidance"; do
    case $PCBM_UI_CHOICE in
      TERMINAL) if ! /usr/bin/pcbm-admin terminal; then notify "Owner terminal" "Authentication was cancelled or failed, or owner setup is incomplete. Retry with the owner account password."; fi; stty sane 2>/dev/null || true ;;
      OWNER|RASPI)
        action=owner;[[ $PCBM_UI_CHOICE != RASPI ]] || action=raspi-config
        if pcbm_ui_confirm "Owner administration" "Advanced changes can alter or break the qualified configuration. Recovery may require restoring settings or reflashing. Continue with your owner account password?"; then
          if ! /usr/bin/pcbm-admin "$action"; then notify "Owner access" "Authenticated owner access needs first-boot account initialization. No universal password or passwordless root shell is supplied."; fi
        fi ;;
      DIAGNOSTICS)
        if [[ -x /usr/bin/pcbm-diagnostics ]]; then
          /usr/bin/pcbm-diagnostics
          read -r -p "Press Enter to return..." _
        else notify "Diagnostics" "Engineering diagnostic capture is unavailable in this installation. System Information and pcbm-info remain available."; fi ;;
      GUIDE) notify "Your Raspberry Pi" "Use the authenticated owner shell for sudo, apt/dpkg, systemctl, boot configuration and ordinary Linux administration. Type exit to return. Keep backups; advanced changes can affect qualification. The normal appliance account has only fixed configuration operations." ;;
    esac
  done
}
section=${1:-root}
case "$section" in region|network|services|machine|picture|storage|advanced) "$section";exit 0 ;; root) ;; *) exit 2 ;; esac
while choose "Project CBM Control" MACHINE "Machine and Startup" PICTURE "Picture, Sound and Controllers" REGION "Language, Keyboard and Region" NETWORK "Network" SERVICES "Services" STORAGE "Content and Storage" INFO "System Information" ABOUT "About Project CBM" ADVANCED "Advanced"; do
  case $PCBM_UI_CHOICE in
    MACHINE) machine ;; PICTURE) picture ;; REGION) region ;; NETWORK) network ;;
    SERVICES) services ;; STORAGE) storage ;; INFO) /usr/bin/pcbm-system-info ;;
    ABOUT) show_about ;; ADVANCED) advanced ;;
  esac
done
exit 0
