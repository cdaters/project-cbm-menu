#!/bin/bash
# Project CBM Machines — familiar launch/default workflow, product registry authority.
# Copyright Project CBM contributors. MIT; see LICENSE.
set -uo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/pcbm-dialog-lib.sh"
source /usr/share/project-cbm-menu/pcbm-ui.sh
pcbm_trap_cleanup
pcbm_ui_terminal_size

notice() { pcbm_ui_message "$1" "$2" || true; }
if ! /usr/bin/pcbm-profiles initialize >/dev/null 2>&1; then
  notice "Preferences unavailable" "Using a validated fallback where possible. Saved preferences have not been overwritten."
fi
mode=launch
while true; do
  if ! model=$(/usr/bin/pcbm-profiles menu 2>/dev/null); then
    notice "Machines unavailable" "The machine registry could not be read. Check the Project CBM runtime installation."
    exit 3
  fi
  items=() current= current_label= pref_status=invalid
  while IFS=$'\t' read -r kind id name description; do
    case "$kind" in
      state) current=$id; current_label=$name; pref_status=$description ;;
      profile)
        label="$name - $description"
        [[ $id != "$current" ]] || label="* $name (current default) - $description"
        items+=("$id" "$label") ;;
      *) exit 3 ;;
    esac
  done <<< "$model"
  if [[ $mode == launch ]]; then
    # Common action first; direct machine launch remains one selection.
    items=(DEFAULT "Set the machine used by RUN" "${items[@]}" RETURN "Back to Main Menu")
    title="Project CBM Machines"
    prompt="Default: $current_label. Choose a machine to launch, or DEFAULT to save a different RUN default."
  else
    items+=(RETURN "Back without changing the default")
    title="Set Default Machine"
    prompt="Default: $current_label. Choose the machine RUN should launch. This does not change boot behavior."
  fi
  [[ $pref_status != invalid ]] || prompt+=" Saved preferences need recovery; a safe fallback is shown."
  if pcbm_ui_menu "$title" "$prompt" "${items[@]}"; then
    choice=$PCBM_UI_CHOICE
  else
    rc=$?
    if (( rc != 1 && rc != 2 )); then
      printf '%s\n' 'Machines needs a usable dialog terminal (at least 40x12).' >&2; exit "$rc"
    fi
    choice=RETURN
  fi
  case "$choice" in
    RETURN) [[ $mode == launch ]] && exit 0; mode=launch; continue ;;
    DEFAULT) mode=default; continue ;;
  esac
  if [[ $mode == default ]]; then
    save_args=(set default_machine "$choice")
    if [[ $pref_status == invalid ]]; then
      if ! pcbm_ui_confirm "Recover preferences?" "Keep a private copy of malformed preferences and save this default? Other invalid preferences return to defaults. Unsafe files require manual recovery."; then continue; fi
      save_args+=(--recover --confirm)
    fi
    if /usr/bin/pcbm-preferences "${save_args[@]}" >/dev/null 2>&1; then
      # Return immediately to the familiar Main Menu; its current label confirms save.
      exit 0
    else
      notice "Default not saved" "The save could not be confirmed. Review the current selection before retrying. Check user preference permissions or recovery instructions; do not change sudoers."
    fi
  else
    if ! pcbm_launch_machine "$choice"; then
      notice "VICE launch failed" "VICE did not exit successfully. Engineering candidates can collect diagnostics from tty2."
    fi
    if [[ $(tty) == /dev/tty1 ]]; then /usr/bin/pcbm-cover; reset; clear; fi
  fi
done
